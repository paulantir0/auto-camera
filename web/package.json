{
  "name": "book-scanner-web",
  "version": "0.1.0",
  "private": true,
  "description": "Book scanner that runs entirely in the browser",
  "type": "module",
  "scripts": {
    "build": "node tools/build.mjs",
    "serve": "node tools/serve.mjs --root dist --port 8765",
    "test": "node --test \"test/*.test.ts\"",
    "typecheck": "tsc -p tsconfig.json",
    "privacy-check": "node tools/privacy-check.mjs",
    "deploy": "node tools/build.mjs && VERCEL_TELEMETRY_DISABLED=1 vercel deploy dist --prod"
  },
  "devDependencies": {
    "@mediapipe/tasks-vision": "0.10.21",
    "@techstark/opencv-js": "4.11.0-release.1",
    "@types/node": "24.19.2",
    "esbuild": "0.28.2",
    "onnxruntime-web": "1.31.1",
    "puppeteer-core": "25.17.0",
    "tesseract.js": "7.0.0",
    "typescript": "7.0.2",
    "vercel": "65.14.0",
    "wabt": "1.0.39"
  }
}
